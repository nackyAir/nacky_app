{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Blog Starter",
    "description": "A blog with posts and pages",
    "author": "EmDash"
  },
  "settings": {
    "title": "Nacky Blog",
    "tagline": "フロントエンドエンジニア Naoki Hayashida の技術メモと開発ログ",
    "timezone": "Asia/Tokyo"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "urlPattern": "/posts/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "commentsEnabled": false,
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/pages/{slug}",
      "supports": ["drafts", "revisions", "preview", "search", "seo"],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "カテゴリ",
      "labelSingular": "カテゴリ",
      "hierarchical": true,
      "collections": ["posts"],
      "terms": [
        {
          "slug": "development",
          "label": "開発"
        },
        {
          "slug": "design",
          "label": "デザイン"
        },
        {
          "slug": "notes",
          "label": "メモ"
        }
      ]
    },
    {
      "name": "tag",
      "label": "タグ",
      "labelSingular": "タグ",
      "hierarchical": false,
      "collections": ["posts"],
      "terms": [
        {
          "slug": "webdev",
          "label": "Web 開発"
        },
        {
          "slug": "opinion",
          "label": "意見"
        },
        {
          "slug": "tools",
          "label": "ツール"
        },
        {
          "slug": "creativity",
          "label": "創作"
        }
      ]
    }
  ],
  "bylines": [
    {
      "id": "byline-editorial",
      "slug": "emdash-editorial",
      "displayName": "EmDash 編集部"
    },
    {
      "id": "byline-guest",
      "slug": "guest-contributor",
      "displayName": "ゲスト寄稿者",
      "isGuest": true
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "ホーム",
          "url": "/"
        },
        {
          "type": "custom",
          "label": "記事",
          "url": "/posts"
        }
      ]
    }
  ],
  "widgetAreas": [
    {
      "name": "sidebar",
      "label": "Sidebar",
      "description": "Widget area displayed on single post pages",
      "widgets": [
        {
          "type": "component",
          "componentId": "core:search",
          "title": "検索"
        },
        {
          "type": "component",
          "componentId": "core:categories",
          "title": "カテゴリ"
        },
        {
          "type": "component",
          "componentId": "core:tags",
          "title": "タグ"
        },
        {
          "type": "component",
          "componentId": "core:recent-posts",
          "title": "最近の記事",
          "settings": {
            "count": 5,
            "showDate": true
          }
        }
      ]
    },
    {
      "name": "footer",
      "label": "Footer",
      "description": "Widget area displayed in the site footer",
      "widgets": [
        {
          "type": "content",
          "title": "このブログについて",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "フロントエンドエンジニア Naoki Hayashida のブログ。Web フロントエンドを中心に、技術メモと開発ログを書いています。",
                  "_key": "k1"
                }
              ],
              "_key": "k0"
            }
          ]
        }
      ]
    }
  ],
  "sections": [
    {
      "slug": "newsletter-signup",
      "title": "ニュースレター登録",
      "description": "A call-to-action block for newsletter subscriptions",
      "keywords": ["newsletter", "subscribe", "email", "cta"],
      "source": "theme",
      "content": [
        {
          "_type": "block",
          "style": "h3",
          "children": [
            {
              "_type": "span",
              "text": "新着記事を受け取る",
              "_key": "k1"
            }
          ],
          "_key": "k0"
        },
        {
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "text": "新しい記事の公開をメールでお知らせします。配信はいつでも解除できます。",
              "_key": "k3"
            }
          ],
          "_key": "k2"
        }
      ]
    },
    {
      "slug": "about-author",
      "title": "著者について",
      "description": "Brief author bio for use in posts or pages",
      "keywords": ["author", "bio", "about"],
      "source": "theme",
      "content": [
        {
          "_type": "block",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "text": "フロントエンドエンジニア Naoki Hayashida のブログ。Web フロントエンドを中心に、技術メモと開発ログを書いています。",
              "_key": "k1"
            }
          ],
          "_key": "k0"
        }
      ]
    }
  ],
  "content": {
    "pages": [],
    "posts": []
  }
}
