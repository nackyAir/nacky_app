{
  "name": "nacky_app",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm with-env turbo dev",
    "lint": "biome lint .",
    "clean": "pnpm with-env turbo run clean",
    "fmt": "biome format --write .",
    "check": "biome check --write .",
    "with-env": "dotenv -e .env.local --"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "lefthook": "^1.8.4",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{tsx,ts,json,js,jsx}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
