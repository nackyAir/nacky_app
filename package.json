{
  "name": "nacky_app",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm with-env turbo dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm with-env turbo run clean",
    "with-env": "dotenv -e .env.local --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "lefthook": "^2.0.9",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
